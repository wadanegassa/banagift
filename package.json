{
  "name": "atelier-gifts",
  "private": true,
  "version": "1.0.0",
  "description": "Premium gift discovery and delivery platform",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:client": "pnpm --filter @atelier/client dev",
    "dev:admin": "pnpm --filter @atelier/admin dev",
    "dev:server": "pnpm --filter @atelier/server dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.2.0"
}
